// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  user
  admin
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          PlatformRole @default(user)

  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships OrganizationMembership[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OrganizationKind {
  PERSONAL_GROUP
  BUSINESS
}

model Organization {
  id        String           @id @default(cuid())
  kind      OrganizationKind
  name      String
  legalName String?
  siren     String?
  vatNumber String?
  logoUrl   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  roles           OrganizationRole[]
  memberships     OrganizationMembership[]
  tradeCategories OrganizationTradeCategory[]
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model OrganizationRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  permissions    Json
  systemKey      String?
  isProtected    Boolean      @default(false)
  position       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationRoleId String
  organizationRole   OrganizationRole @relation(fields: [organizationRoleId], references: [id])
  status             MembershipStatus
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TradeCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations OrganizationTradeCategory[]
}

model OrganizationTradeCategory {
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tradeCategoryId String
  tradeCategory   TradeCategory @relation(fields: [tradeCategoryId], references: [id], onDelete: Cascade)

  @@id([organizationId, tradeCategoryId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
