// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  user
  admin
}

enum LotColor {
  NAVY
  BLUE
  SKY
  CYAN
  INDIGO
  VIOLET
  PURPLE
  FUCHSIA
  PINK
  ROSE
  RED
  ORANGE
  AMBER
  YELLOW
  SLATE
  ZINC
  STONE
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          PlatformRole @default(user)

  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                Account[]
  sessions                Session[]
  memberships             OrganizationMembership[]
  sentInvitations         OrganizationInvitation[]
  sentProjectInvitations  ProjectInvitation[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OrganizationKind {
  BUILDING_COMPANY
  CLIENT_COMPANY
  INDIVIDUAL_CLIENT
}

model Organization {
  id        String           @id @default(cuid())
  slug      String           @unique
  kind      OrganizationKind
  name        String
  description String?
  legalName   String?
  siren       String?
  siret       String?
  vatNumber String?
  logoUrl   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  memberships           OrganizationMembership[]
  invitations           OrganizationInvitation[]
  tradeCategories       OrganizationTradeCategory[]
  leadProjects          Project[]
  projectParticipations ProjectParticipant[]
  libraryFolders          LibraryFolder[]
  workItemTemplates       WorkItemTemplate[]
  workPackageTemplates    WorkPackageTemplate[]
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrganizationMemberRole {
  FOUNDER
  MANAGER
  MEMBER
}

model OrganizationMembership {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(MEMBER)
  status         MembershipStatus
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, userId])

  projectParticipantMembers ProjectParticipantMember[]
}

model OrganizationInvitation {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrganizationMemberRole @default(MEMBER)
  token          String                 @unique
  expiresAt      DateTime
  invitedById    String
  invitedBy      User                   @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
}

model TradeCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations        OrganizationTradeCategory[]
  workPackages         WorkPackageTradeCategory[]
  workItems            WorkItem[]
  workItemTemplates    WorkItemTemplate[]
  workPackageTemplates WorkPackageTemplate[]
}


model OrganizationTradeCategory {
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tradeCategoryId String
  tradeCategory   TradeCategory @relation(fields: [tradeCategoryId], references: [id], onDelete: Cascade)

  @@id([organizationId, tradeCategoryId])
}

model Project {
  id                   String       @id @default(cuid())
  leadOrganizationId   String
  leadOrganization     Organization @relation(fields: [leadOrganizationId], references: [id], onDelete: Cascade)
  slug                 String
  name                 String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  participants      ProjectParticipant[]
  spaces            ProjectSpace[]
  workPackages      WorkPackage[]
  workItems         WorkItem[]
  clientInvitation  ProjectInvitation?

  @@unique([leadOrganizationId, slug])
}

model ProjectInvitation {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedEmail String
  token        String   @unique
  expiresAt    DateTime
  invitedById  String
  invitedBy    User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

enum ProjectParticipantRole {
  LEAD
  CLIENT
  SUBCONTRACTOR
}

model ProjectParticipant {
  id             String                 @id @default(cuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           ProjectParticipantRole
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  members              ProjectParticipantMember[]
  assignedWorkPackages WorkPackage[]
}

model ProjectParticipantMember {
  id                       String                 @id @default(cuid())
  projectParticipantId     String
  projectParticipant       ProjectParticipant     @relation(fields: [projectParticipantId], references: [id], onDelete: Cascade)
  organizationMembershipId String
  organizationMembership   OrganizationMembership @relation(fields: [organizationMembershipId], references: [id], onDelete: Cascade)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

enum WorkItemStatus {
  DRAFT
  IN_PROGRESS
  DONE
  CANCELLED
}

model ProjectSpace {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ProjectSpace?  @relation("ProjectSpaceHierarchy", fields: [parentId], references: [id])
  children  ProjectSpace[] @relation("ProjectSpaceHierarchy")
  name      String
  position  Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  workItems WorkItem[]
}

model WorkPackage {
  id                             String               @id @default(cuid())
  projectId                      String
  project                        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedProjectParticipantId   String?
  assignedProjectParticipant     ProjectParticipant?  @relation(fields: [assignedProjectParticipantId], references: [id])
  sourceWorkPackageTemplateId    String?
  sourceWorkPackageTemplate      WorkPackageTemplate? @relation(fields: [sourceWorkPackageTemplateId], references: [id], onDelete: SetNull)
  name                           String
  description                    String?
  color                          LotColor?
  position                       Int
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  tradeCategories WorkPackageTradeCategory[]
  workItems       WorkItem[]
}

model WorkPackageTradeCategory {
  workPackageId   String
  workPackage     WorkPackage   @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  tradeCategoryId String
  tradeCategory   TradeCategory @relation(fields: [tradeCategoryId], references: [id], onDelete: Cascade)

  @@id([workPackageId, tradeCategoryId])
}

model WorkItem {
  id                   String         @id @default(cuid())
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId        String?
  workPackage          WorkPackage?   @relation(fields: [workPackageId], references: [id])
  projectSpaceId       String?
  projectSpace         ProjectSpace?  @relation(fields: [projectSpaceId], references: [id])
  tradeCategoryId      String?
  tradeCategory        TradeCategory? @relation(fields: [tradeCategoryId], references: [id])
  sourceWorkItemTemplateId String?
  sourceWorkItemTemplate   WorkItemTemplate?  @relation(fields: [sourceWorkItemTemplateId], references: [id])
  name                 String
  description          String?
  quantity             Decimal
  unit                 String
  status               WorkItemStatus @default(DRAFT)
  executions           Json           @default("[]")
  position             Int
  plannedStartDate     DateTime?
  plannedEndDate       DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model LibraryFolder {
  id                    String               @id @default(cuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId              String?
  parent                LibraryFolder?       @relation("LibraryFolderHierarchy", fields: [parentId], references: [id])
  children              LibraryFolder[]      @relation("LibraryFolderHierarchy")
  workPackageTemplateId String?
  workPackageTemplate   WorkPackageTemplate? @relation("LibraryFolderTag", fields: [workPackageTemplateId], references: [id], onDelete: SetNull)
  name                  String
  position              Int
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  workItemTemplates    WorkItemTemplate[]
  workPackageTemplates WorkPackageTemplate[] @relation("WorkPackageTemplateFolder")
}

model WorkItemTemplate {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folderId         String?
  folder           LibraryFolder? @relation(fields: [folderId], references: [id])
  tradeCategoryId  String?
  tradeCategory    TradeCategory? @relation(fields: [tradeCategoryId], references: [id])
  name             String
  description      String?
  unit             String
  defaultTaxRate   Decimal?
  defaultUnitPrice Decimal?
  estimatedUnitCost Decimal?
  quantityExpression String?
  defaultChecklist  Json     @default("[]")
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workItems WorkItem[]
}

model WorkPackageTemplate {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folderId           String?
  folder             LibraryFolder? @relation("WorkPackageTemplateFolder", fields: [folderId], references: [id])
  tradeCategoryId    String?
  tradeCategory      TradeCategory? @relation(fields: [tradeCategoryId], references: [id])
  name               String
  description        String?
  color              LotColor?
  defaultMarginRate  Decimal?
  position           Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  derivedWorkPackages WorkPackage[]
  taggedFolders       LibraryFolder[] @relation("LibraryFolderTag")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
