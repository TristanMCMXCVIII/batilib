# Better Auth
BETTER_AUTH_SECRET=                     # Clé secrète aléatoire (min 32 chars) — openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000   # URL publique de l'app (prod : https://...)

# Base de données
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/batilib

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo (email transactionnel) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_NAME=Batilib
BREVO_SENDER_EMAIL=no-reply@example.com

# Cloudflare R2 (stockage fichiers) — https://dash.cloudflare.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
